{
  "name": "playwright-output",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript specs produced by the Selenium-to-Playwright migrator",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
